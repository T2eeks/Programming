<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:WpfApp1"
        xmlns:vm="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="800"
        Padding="15">

    <!-- Установка DataContext -->
    <Window.DataContext>
        <vm:MainVM />
    </Window.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Кнопки Save и Load -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Height="25" Margin="3" Command="{Binding SaveCommand}"/>
            <Button Content="Load" Width="75" Height="25" Margin="3" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Edit Contact -->
            <GroupBox Header="Edit Contact" Grid.Column="0" Margin="10">
                <StackPanel Margin="10">
                    <Label Content="Name:" Margin="3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="3"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="3">
                        <Validation.ErrorTemplate>
                            <ControlTemplate>
                                <StackPanel>
                                    <AdornedElementPlaceholder/>
                                    <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Validation.ErrorTemplate>
                    </TextBox>
                    <Label Content="Email:" Margin="3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="3">
                        <Validation.ErrorTemplate>
                            <ControlTemplate>
                                <StackPanel>
                                    <AdornedElementPlaceholder/>
                                    <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Validation.ErrorTemplate>
                    </TextBox>
                </StackPanel>
            </GroupBox>

            <!-- Read Contact -->
            <GroupBox Header="Read Contact" Grid.Column="1" Margin="10">
                <StackPanel Margin="10">
                    <Label Content="Name:" Margin="3"/>
                    <TextBlock Text="{Binding Name}" Margin="3" FontWeight="Bold"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBlock Text="{Binding Number}" Margin="3" FontWeight="Bold"/>
                    <Label Content="Email:" Margin="3"/>
                    <TextBlock Text="{Binding Email}" Margin="3" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
